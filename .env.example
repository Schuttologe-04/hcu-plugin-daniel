# Copy to a local .env and load explicitly with Node --env-file=.env.
# No token is supplied by this example. Never commit your local credentials.
HCU_WS_URL=wss://hcu1-XXXX.local:9001
HCU_AUTHTOKEN=
HCU_PLUGIN_ID=com.psd.hcu.goe.loadmanagement
HCU_ALLOW_SELF_SIGNED=false
HCU_DATA_DIR=./data
# LIVE additionally requires its separate entry point. Read-only modes ignore this flag.
GOE_REAL_WRITES_ENABLED=false
